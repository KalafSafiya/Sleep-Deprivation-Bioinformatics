)
# Extract statistically significant recovery results
significant_recovery <- annotated_recovery[
!is.na(annotated_recovery$adj.P.Val) &
annotated_recovery$adj.P.Val < 0.05,
]
# Display significant genes
significant_recovery[, c(
"PROBEID",
"SYMBOL",
"GENENAME",
"logFC",
"P.Value",
"adj.P.Val"
)]
write.csv(
significant_recovery,
"data/significant_recovery_genes.csv",
row.names = FALSE
)
# Extract TAF4 results from all six comparisons
taf4_results <- lapply(
colnames(fit2$coefficients),
function(comparison) {
result <- topTable(
fit2,
coef = comparison,
number = Inf,
adjust.method = "BH"
)
result["8067361", c(
"logFC",
"P.Value",
"adj.P.Val"
)]
}
)
# Combine results
taf4_summary <- do.call(rbind, taf4_results)
taf4_summary$Comparison <- colnames(fit2$coefficients)
# Display
taf4_summary <- taf4_summary[, c(
"Comparison",
"logFC",
"P.Value",
"adj.P.Val"
)]
taf4_summary
# Extract TAF4 expression values
taf4_expression <- data.frame(
Expression = as.numeric(expr["8067361", ]),
Group = meta$subject_group,
Phase = meta$study_phase,
Subject = meta$subject_id
)
# Load ggplot2
library(ggplot2)
# Create expression plot
ggplot(
taf4_expression,
aes(x = Phase, y = Expression, fill = Group)
) +
geom_boxplot(
position = position_dodge(width = 0.8),
alpha = 0.7
) +
labs(
title = "TAF4 Expression Across Study Phases",
x = "Study Phase",
y = "Normalized Gene Expression",
fill = "Group"
) +
theme_minimal()
# Calculate variability for each transcript cluster
gene_variance <- apply(expr, 1, var)
# Select the 500 most variable transcript clusters
top_variable <- names(
sort(gene_variance, decreasing = TRUE)
)[1:500]
# Prepare expression data
pca_data <- t(expr[top_variable, ])
# Perform PCA
pca_result <- prcomp(
pca_data,
center = TRUE,
scale. = TRUE
)
# Calculate percentage of variance explained
variance_explained <- (
pca_result$sdev^2 /
sum(pca_result$sdev^2)
) * 100
# Prepare plotting data
pca_df <- data.frame(
PC1 = pca_result$x[, 1],
PC2 = pca_result$x[, 2],
Group = meta$subject_group,
Phase = meta$study_phase
)
library(ggplot2)
ggplot(
pca_df,
aes(
x = PC1,
y = PC2,
color = Group,
shape = Phase
)
) +
geom_point(size = 3, alpha = 0.8) +
labs(
title = "PCA of Gene Expression Profiles",
x = paste0(
"PC1 (",
round(variance_explained[1], 2),
"%)"
),
y = paste0(
"PC2 (",
round(variance_explained[2], 2),
"%)"
),
color = "Group",
shape = "Study Phase"
) +
theme_minimal()
install.packages("pheatmap")
library(pheatmap)
# Calculate variance for each transcript cluster
gene_variance <- apply(expr, 1, var)
# Select the top 30 most variable transcript clusters
top30 <- names(
sort(gene_variance, decreasing = TRUE)
)[1:30]
# Extract their expression values
heatmap_data <- expr[top30, ]
# Arrange samples by group and study phase
sample_order <- order(
meta$subject_group,
meta$study_phase,
meta$subject_id
)
# Reorder expression data
heatmap_data <- heatmap_data[, sample_order]
# Create sample annotation
sample_annotation <- data.frame(
Group = meta$subject_group[sample_order],
Phase = meta$study_phase[sample_order]
)
rownames(sample_annotation) <- colnames(heatmap_data)
pheatmap(
heatmap_data,
scale = "row",
annotation_col = sample_annotation,
show_colnames = FALSE,
fontsize_row = 8,
clustering_method = "complete",
main = "Heatmap of Top 30 Variable Transcript Clusters"
)
if (!requireNamespace("BiocManager", quietly = TRUE)) {
install.packages("BiocManager")
}
BiocManager::install(c("clusterProfiler", "org.Hs.eg.db"))
library(clusterProfiler)
BiocManager::install("enrichplot", ask = FALSE, update = FALSE)
library(enrichplot)
library(clusterProfiler)
library(org.Hs.eg.db)
library(AnnotationDbi)
primary_results <- topTable(
fit2,
coef = "Experimental_Difference",
number = Inf,
adjust.method = "BH",
sort.by = "none"
)
head(primary_results)
primary_results$PROBEID <- rownames(primary_results)
primary_annotations <- AnnotationDbi::select(
hugene10sttranscriptcluster.db,
keys = primary_results$PROBEID,
keytype = "PROBEID",
columns = c("SYMBOL", "ENTREZID")
)
primary_annotated <- merge(
primary_results,
primary_annotations,
by = "PROBEID"
)
primary_annotated <- primary_annotated[
!is.na(primary_annotated$ENTREZID),
]
primary_annotated <- primary_annotated[
order(abs(primary_annotated$t), decreasing = TRUE),
]
primary_unique <- primary_annotated[
!duplicated(primary_annotated$ENTREZID),
]
gene_list <- primary_unique$t
names(gene_list) <- primary_unique$ENTREZID
gene_list <- sort(gene_list, decreasing = TRUE)
head(gene_list)
gsea_result <- gseKEGG(
geneList = gene_list,
organism = "hsa",
minGSSize = 10,
maxGSSize = 500,
pvalueCutoff = 1,
pAdjustMethod = "BH"
)
gsea_table <- as.data.frame(gsea_result)
head(gsea_table, 10)
# Count all pathways returned
total_pathways <- nrow(gsea_table)
# Extract statistically significant pathways
significant_pathways <- gsea_table[
!is.na(gsea_table$p.adjust) &
gsea_table$p.adjust < 0.05,
]
# Display summary
cat("Total pathways:", total_pathways, "\n")
cat(
"Significant pathways:",
nrow(significant_pathways),
"\n"
)
# Display significant pathways
significant_pathways[, c(
"Description",
"setSize",
"NES",
"pvalue",
"p.adjust"
)]
write.csv(
gsea_table,
"data/KEGG_GSEA_all_results.csv",
row.names = FALSE
)
write.csv(
significant_pathways,
"data/KEGG_GSEA_significant_pathways.csv",
row.names = FALSE
)
set.seed(123)
gene_list_checked <- gene_list +
runif(length(gene_list), -1e-10, 1e-10)
gene_list_checked <- sort(
gene_list_checked,
decreasing = TRUE
)
gsea_checked <- gseKEGG(
geneList = gene_list_checked,
organism = "hsa",
minGSSize = 10,
maxGSSize = 500,
pvalueCutoff = 1,
pAdjustMethod = "BH",
eps = 0
)
gsea_checked_table <- as.data.frame(gsea_checked)
head(
gsea_checked_table[, c(
"Description",
"NES",
"pvalue",
"p.adjust"
)],
10
)
# Count verified significant pathways
verified_significant <- gsea_checked_table[
!is.na(gsea_checked_table$p.adjust) &
gsea_checked_table$p.adjust < 0.05,
]
cat(
"Total pathways:",
nrow(gsea_checked_table),
"\n"
)
cat(
"Verified significant pathways:",
nrow(verified_significant),
"\n"
)
library(ggplot2)
# Select the 15 most significant pathways
top_pathways <- verified_significant[
order(verified_significant$p.adjust),
][1:min(15, nrow(verified_significant)), ]
# Create dot plot
gsea_plot <- ggplot(
top_pathways,
aes(
x = NES,
y = reorder(Description, NES),
size = setSize,
color = -log10(p.adjust)
)
) +
geom_point(alpha = 0.9) +
scale_color_gradient(
low = "skyblue",
high = "darkred"
) +
labs(
title = "KEGG Gene Set Enrichment Analysis",
subtitle = "Top 15 significantly enriched pathways",
x = "Normalized Enrichment Score (NES)",
y = "KEGG Pathway",
size = "Gene Set Size",
color = "-log10 Adjusted P-value"
) +
theme_minimal() +
theme(
plot.title = element_text(face = "bold"),
axis.text.y = element_text(size = 9)
)
print(gsea_plot)
library(enrichplot)
library(ggplot2)
